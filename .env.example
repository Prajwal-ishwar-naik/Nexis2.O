# Nexis AI - Environment Configuration Example
# Copy this file to .env and provide your respective API keys.

# Inference Provider ('groq' or 'ollama')
INFERENCE_PROVIDER=groq

# Groq Cloud Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_ORCHESTRATOR_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Local Ollama Configuration (Fallback / Offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_ORCHESTRATOR_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision:latest

# Search & Media API Keys
YOUTUBE_API_KEY=your_youtube_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Open Data & Public Registry APIs
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
RXNORM_API_URL=https://rxnav.nlm.nih.gov/REST/drugs.json
OPENFDA_API_URL=https://api.fda.gov/drug/label.json
OPENLIBRARY_API_URL=https://openlibrary.org/search.json
ARXIV_API_URL=http://export.arxiv.org/api/query
MYSCHEME_PORTAL_URL=https://www.myscheme.gov.in

# Server Ports & Host
HOST=127.0.0.1
GATEWAY_PORT=8000
AGRI_PORT=8001
HEALTH_PORT=8002
EDU_PORT=8003
CIVIC_PORT=8004

# Service URLs for Gateway Routing
AGRI_SERVICE_URL=http://127.0.0.1:8001
HEALTH_SERVICE_URL=http://127.0.0.1:8002
EDU_SERVICE_URL=http://127.0.0.1:8003
CIVIC_SERVICE_URL=http://127.0.0.1:8004
